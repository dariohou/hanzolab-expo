{
  "expo": {
    "name": "GTG",
    "slug": "gtg",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "gtg",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#1a1a1a",
      "resizeMode": "contain"
    },
    "ios": {
      "bundleIdentifier": "com.hanzolab.gtg",
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": ["fetch", "remote-notification"]
      }
    },
    "android": {
      "package": "com.hanzolab.gtg",
      "adaptiveIcon": {
        "backgroundColor": "#1a1a1a"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "ios": {
            "newArchEnabled": true
          },
          "android": {
            "newArchEnabled": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
